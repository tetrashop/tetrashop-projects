# =============================================
#  TetraShop – متغیرهای محیطی برای Production
# =============================================
# این فایل را به عنوان .env.local کپی کنید و مقادیر را پر کنید.
# در Vercel این متغیرها را در Settings → Environment Variables وارد کنید.

# --- ۱. کلید امنیتی JWT (حتماً تغییر دهید) ---
JWT_SECRET=change-me-to-a-random-64-char-string

# --- ۲. پایگاه داده MongoDB Atlas (رایگان) ---
# از https://www.mongodb.com/atlas یک کلاستر رایگان بسازید
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/tetrashop?retryWrites=true&w=majority

# --- ۳. درگاه پرداخت (زرین‌پال) ---
# در https://www.zarinpal.com ثبت‌نام کنید و Merchant ID بگیرید
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=https://tetrashop-projects-seven.vercel.app/api/payment/verify

# --- ۴. ایمیل (Resend) ---
# در https://resend.com ثبت‌نام کنید و API Key بگیرید
EMAIL_API_KEY=re_xxxxxx
EMAIL_FROM=support@tetrashop.ir

# --- ۵. کیف پول TON (نمایش واقعی) ---
NEXT_PUBLIC_TON_ADDRESS=UQBgjRhKP_MEUN8pcfxTMmY-uj8RdRyb9yl_czQ6VcSRV3Ol
TONCENTER_API_KEY=   # از https://toncenter.com دریافت کنید (اختیاری)

# --- ۶. Cloudinary (آپلود تصاویر) ---
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# --- ۷. آدرس سایت ---
NEXT_PUBLIC_SITE_URL=https://tetrashop-projects-seven.vercel.app
